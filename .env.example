# Server
PORT=5000
# Only takes effect when running "npm run dev" directly on your host.
# docker-compose.yml pins NODE_ENV=production for the "app" and "email-worker"
# containers regardless of what's set here, so stack traces never leak and
# auth cookies always get the Secure flag in that environment.
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/task_management

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Upload
MAX_FILE_SIZE=10485760

# RabbitMQ (email job queue)
RABBITMQ_URL=amqp://localhost:5672

# Redis (cache-aside layer — dashboard, task detail, user-by-role lists)
REDIS_URL=redis://localhost:6379

# SMTP (used by the email worker). Defaults below match MailHog for local dev
# (catches mail at http://localhost:8025, sends nothing real). Point at a
# real provider (SES, SendGrid, etc.) in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Task Management <no-reply@taskapp.local>
